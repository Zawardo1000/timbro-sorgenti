<?xml version="1.0" encoding="utf-8"?>
<!-- Release: solo HTTPS, con le CA di sistema. Il certificato client (mTLS) lo presenta ClientApi. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
