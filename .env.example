# Configurazione del backend. Sul PC: copia in .env (facoltativo: compose.yaml ha gia' i valori per il PC).
# Sul server: nel .env dell'app, leggibile solo da root; percorsi e porta li fissa il compose del server.
# I nomi delle variabili sono i campi di timbro/config.py in maiuscolo.

# Database Postgres (OBBLIGATORIA, SEGRETO: contiene la password).
# Sul PC la imposta compose.yaml; sul server: postgresql+psycopg://timbro:<password>@postgres:5432/timbro
# DATABASE_URL=

# Indirizzo pubblico della pagina dei link di condivisione (non segreto).
# Sul server: l'indirizzo pubblico vero, es. https://timbro.example.it (nel compose del server)
# PUBLIC_BASE_URL=http://127.0.0.1:8012

# Certificati client mTLS rilasciati all'associazione (timbro/enroll.py, POST /api/v1/enroll): CA intermedia di
# Timbro (firmata dalla radice che nginx usa per verificare), file montati in sola lettura. La chiave è un SEGRETO.
# Sul PC si generano con tests/scripts/ca_sviluppo.py. Senza, /api/v1/enroll risponde 503.
# CLIENT_CA_CERT_FILE=/ca/client-ca.crt
# CLIENT_CA_KEY_FILE=/ca/client-ca.key
# CLIENT_CERT_DAYS=730

# Mail di contestazione (timbro/mailer.py): una casella esistente via SMTP. Con Gmail serve la verifica in due
# passaggi e una "password per le app" (https://myaccount.google.com/apppasswords). Senza SMTP_HOST la
# contestazione crea solo il link. Il mittente riceve la copia nella cartella "Inviati" di Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl               # ssl (porta 465) oppure starttls (porta 587)
# SMTP_USER=nome.cognome@gmail.com
# SMTP_PASSWORD=                  # SEGRETO: la password per le app, la scrive l'utente sul server
# SMTP_FROM=Nome Cognome <nome.cognome@gmail.com>

# Attestazione hardware dell'app Android (docs/PROGETTO.md §19), non segrete: da impostare quando c'è l'APK.
# ATTESTATION_PACKAGE=it.zawardo.timbro                        nome del pacchetto dell'app
# ATTESTATION_SIGNING_CERT_SHA256=["<sha256 del certificato di firma dell'app, esadecimale>"]
#   solo quello di Google Play (Play Console > Integrita' dell'app > Firma dell'app): la pagina pubblica presenta
#   l'app verificata come firmata da Google Play. Mai la chiave di caricamento o quella di debug

# Facoltative, con i valori predefiniti di config.py:
# TSA_PROVIDERS=["accv","sectigo-q"]                        marche sul video, in ordine di priorita'
# RECORD_TSA_PROVIDERS=["accv","sectigo-q"]                 marche sul record (chain_hash) e sull'attestazione
# OTS_ENABLED=true                                           prove OpenTimestamps
# MAX_VIDEO_BYTES=52428800                                   dimensione massima di un video (anche in nginx)
# WORKER_ENABLED=true                                        marche, conservazione, controlli periodici
